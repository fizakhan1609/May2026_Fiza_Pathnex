  hosts: all
  become: yes 
  tasks:
    - name: Create user
      user:
        name: pathnex
       state: pathnex
        state: present
        shell: /bin/bash
    - name: Set permissions for the user
      file:
        path: /home/apthnex
        owner: pathnex
        group: pathnex
        mode: '0755'
